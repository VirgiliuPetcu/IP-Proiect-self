@* Side Navigation Component *@

<aside class="sidebar">
    <div class="sidebar-header">
        <div class="logo-box">
            <img src="images/logo-unilab.svg" alt="UniLab Logo" class="logo-img" />
        </div>
        <div class="logo-text">
            <span class="brand-name">UniLab</span>
            <span class="brand-sub">RESOURCE MANAGEMENT</span>
        </div>
    </div>

    <div class="sidebar-section">
        <span class="section-label">WORKSPACE</span>
        <nav class="nav-menu">
            @* TODO: Adaugă rutele reale (href) și logica de activare pentru fiecare link din meniu *@
            
            <NavLink href="/equipment-catalog" class="nav-item">
                <img src="images/icon-catalog.svg" alt="" class="nav-icon" />
                <span>Equipment Catalog</span>
            </NavLink>

            <NavLink href="/my-reservations" class="nav-item active">
                <img src="images/icon-calendar.svg" alt="" class="nav-icon" />
                <span>My Reservations</span>
            </NavLink>

            <NavLink href="/notifications" class="nav-item">
                <img src="images/icon-exclamation.svg" alt="" class="nav-icon" />
                <span>Notifications</span>
                @* TODO: Leagă numărul de notificări necitite la o variabilă dinamică *@
                <span class="nav-badge">3</span>
            </NavLink>

            <NavLink href="/profile" class="nav-item">
                <img src="images/icon-profile.svg" alt="" class="nav-icon" />
                <span>Profile</span>
            </NavLink>

            <NavLink href="/settings" class="nav-item">
                <img src="images/icon-settings.svg" alt="" class="nav-icon" />
                <span>Settings</span>
            </NavLink>
        </nav>
    </div>

    <div class="sidebar-footer">
        @* TODO: Adaugă acțiune / link pentru Help & support *@
        <NavLink href="/help" class="help-link">
            <img src="images/icon-help.svg" alt="" class="nav-icon" />
            <span>Help &amp; support</span>
        </NavLink>
        <div class="campus-label">Engineering &amp; Technology Campus</div>
    </div>
</aside>


